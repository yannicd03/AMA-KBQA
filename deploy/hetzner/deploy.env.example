# Deployment configuration for the public demo.
#
# Copy this file to deploy.env and fill in the values for your own host:
#
#     cp deploy/hetzner/deploy.env.example deploy/hetzner/deploy.env
#
# deploy.env is gitignored. It holds host-specific values (origin IP, tunnel
# id, deploy user) that must not be committed to a public repository. The
# rendered config files produced from it are gitignored for the same reason.
#
# Render the cloudflared config and systemd unit from the templates with:
#
#     ./deploy/hetzner/render-deploy-config.sh
#
# The Cloudflare tunnel *credentials JSON* is a separate secret. It is never
# rendered, never committed, and lives only on the server.

# ============================================================
# Target host
# ============================================================

# Origin address of the box the demo runs on. Keep this out of git: it lets
# traffic bypass the Cloudflare proxy and hit the origin directly.
DEPLOY_HOST=203.0.113.10

# Optional ssh alias (from your ~/.ssh/config) used by the deployment SOP.
DEPLOY_SSH_ALIAS=demo-host

# Unix user that owns the deployment and runs the tunnel.
DEPLOY_USER=deploy

# Home directory of DEPLOY_USER on the server. Used to locate the cloudflared
# config and credentials.
DEPLOY_HOME=/home/deploy

# ============================================================
# Cloudflare tunnel
# ============================================================

# Tunnel name as shown by `cloudflared tunnel list`.
CLOUDFLARE_TUNNEL_NAME=your-tunnel-name

# Tunnel UUID. `cloudflared tunnel list` prints it next to the name.
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Directory holding <tunnel-id>.json on the server. The credentials file
# itself is secret and is never generated by the render script.
CLOUDFLARE_CREDENTIALS_DIR=${DEPLOY_HOME}/.cloudflared

# ============================================================
# Public endpoints
# ============================================================

# Primary public hostname for the demo.
DEMO_HOSTNAME=demo.example.com

# Staging hostname, used to smoke-test a deploy before the primary hostname
# is repointed at it.
DEMO_STAGING_HOSTNAME=demo-next.example.com

# Loopback ports the two compose projects bind their frontend to. The tunnel
# is the only thing that reaches them; nothing is bound to a public interface.
DEMO_PORT=8503
DEMO_STAGING_PORT=8504
