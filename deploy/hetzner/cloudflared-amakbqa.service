[Unit]
Description=cloudflared tunnel for the AMA-KBQA demo (amakbqa.yanlab.de)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=yannic
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /home/yannic/.cloudflared/amakbqa.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
