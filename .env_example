# AMA KBQA Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# LLM Provider API Keys
# ============================================================
# Configure which providers to use in config.toml
# Only provide API keys for the providers you're actually using

# OpenRouter (https://openrouter.ai/)
# Used for: Chat and Embedding models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# KIT AI Toolbox (https://ki-toolbox.scc.kit.edu/)
# Used for: Chat models
KIT_API_KEY=your_kit_api_key_here

# ============================================================
# Legacy/Optional Configuration
# ============================================================
# These are optional and override config.toml if set

# Override the chat model name
# MODEL_NAME=arcee-ai/trinity-mini

# Override request timeout in seconds
# REQUEST_TIMEOUT_SECONDS=60

# Override MCP server path
# SUBAGENT_SERVER_PATH=/path/to/custom/server.py

# ============================================================
# General API Key (Legacy)
# ============================================================
# This was used in older versions
# API_KEY=temp

# ============================================================
# LangGraph engine (opt-in, [agent].engine = "graph")
# ============================================================
# Override the engine per-process instead of editing config.toml:
# AMA_AGENT_ENGINE=graph

# LangSmith tracing is opt-in and picked up automatically by LangChain/
# LangGraph from these two env vars -- no code in this repo references them.
# TraceRecorder (ama_kbqa/framework/trace.py) remains the primary trace
# source either way. See .agent/Tasks/active/langgraph-rewrite.md.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
