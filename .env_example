# AMA KBQA Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# LLM Provider API Keys
# ============================================================
# Configure which providers to use in config.toml
# Only provide API keys for the providers you're actually using

# OpenRouter (https://openrouter.ai/)
# Used for: Chat and Embedding models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# KIT AI Toolbox (https://ki-toolbox.scc.kit.edu/)
# Used for: Chat models
KIT_API_KEY=your_kit_api_key_here

# DeepSeek direct (https://api.deepseek.com)
# Used for: Chat models only (embeddings stay on KIT).
# Optional: without it the demo model picker simply hides the DeepSeek entries.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================================
# Legacy/Optional Configuration
# ============================================================
# These are optional and override config.toml if set

# Override the chat model name
# MODEL_NAME=arcee-ai/trinity-mini

# Override request timeout in seconds
# REQUEST_TIMEOUT_SECONDS=60

# Override MCP server path
# SUBAGENT_SERVER_PATH=/path/to/custom/server.py

# ============================================================
# General API Key (Legacy)
# ============================================================
# This was used in older versions
# API_KEY=temp

# ============================================================
# Deployment (server only)
# ============================================================
# Only needed on the host that serves the public demo. Docker Compose reads
# these from .env automatically.

# Absolute path to the v1 demo checkout on the server. The staging stack
# (docker-compose.hetzner-next.yml) mounts its already-seeded datasets and
# questionnaires read-only instead of keeping a second copy.
# DEMO_V1_DATA_ROOT=/home/youruser/amakbqa-demo

# Host-specific tunnel and hostname settings live in a separate gitignored
# file, deploy/hetzner/deploy.env. Start from deploy/hetzner/deploy.env.example
# and render the cloudflared config with
# ./deploy/hetzner/render-deploy-config.sh.
