# AMA-KBQA Streamlit frontend — containerized for auto-restart and lifecycle uniformity.
#
# Runs ama-kbqa-frontend on port 8502, bound to 127.0.0.1 inside the container.
# Uses network_mode: host in compose so the frontend can reach Qdrant (localhost:6335)
# and Virtuoso (localhost:8890) without any config.toml changes.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dependency resolution — cached layer (only invalidates when pyproject/lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --no-install-project

# App code — rebuilds this layer on every source change, leaves deps cached
COPY ama_kbqa/ ./ama_kbqa/
COPY config.toml ./config.toml
RUN uv pip install --no-deps -e .

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8502

CMD ["ama-kbqa-frontend", "--server.port", "8502", "--server.address", "0.0.0.0", "--server.headless", "true"]
